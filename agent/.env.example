# Used when MODEL_PROVIDER=claude. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Optional, defaults to claude-haiku-4-5-20251001 (cheapest/fastest)
ANTHROPIC_MODEL=""
